{
  "name": "ysschool-lesson-plan-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:admin": "node --test tests/admin.test.mjs",
    "validate": "node scripts/validate-records.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build": "npm run validate && npm run build:catalog && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "import": "node scripts/import-submission.mjs",
    "approve": "node scripts/approve-submission.mjs",
    "check:duplicates": "node scripts/check-duplicates.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.55.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  }
}
